      <ownedAttribute xmi:type="uml:Property" xmi:id="lifeline_login_page" name="Trang Đăng Nhập"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="lifeline_auth" name="Hệ Thống Xác Thực"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="lifeline_user_db" name="Cơ Sở Dữ Liệu"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="lifeline_session" name="Session Storage"/>
    </packagedElement>
    
    <!-- Interaction (Sequence Diagram) -->
    <packagedElement xmi:type="uml:Interaction" xmi:id="interaction_dang_nhap" name="Quy trình Đăng Nhập">
      
      <!-- Lifelines -->
      <lifeline xmi:type="uml:Lifeline" xmi:id="ll_user" name="Người Dùng" represents="lifeline_user"/>
