      <message xmi:type="uml:Message" xmi:id="msg_dn_5" name="5. Validate dữ liệu đầu vào" messageSort="synchCall" sendEvent="send_dn_5" receiveEvent="recv_dn_5"/>
      <message xmi:type="uml:Message" xmi:id="msg_dn_6" name="6. Gửi yêu cầu xác thực" messageSort="synchCall" sendEvent="send_dn_6" receiveEvent="recv_dn_6"/>
      <message xmi:type="uml:Message" xmi:id="msg_dn_7" name="7. Tìm kiếm tài khoản" messageSort="synchCall" sendEvent="send_dn_7" receiveEvent="recv_dn_7"/>
