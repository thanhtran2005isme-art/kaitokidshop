      <message xmi:type="uml:Message" xmi:id="msg_dn_10" name="10. Tạo session đăng nhập" messageSort="synchCall" sendEvent="send_dn_10" receiveEvent="recv_dn_10"/>
      <message xmi:type="uml:Message" xmi:id="msg_dn_11" name="11. Lưu thông tin session" messageSort="synchCall" sendEvent="send_dn_11" receiveEvent="recv_dn_11"/>
