      <lifeline xmi:type="uml:Lifeline" xmi:id="ll_session" name="Session Storage" represents="lifeline_session"/>
      
      <!-- Messages -->
      <message xmi:type="uml:Message" xmi:id="msg_dn_1" name="1. Truy cập trang đăng nhập" messageSort="synchCall" sendEvent="send_dn_1" receiveEvent="recv_dn_1"/>
      <message xmi:type="uml:Message" xmi:id="msg_dn_2" name="2. Hiển thị form đăng nhập" messageSort="reply" sendEvent="send_dn_2" receiveEvent="recv_dn_2"/>
