      <lifeline xmi:type="uml:Lifeline" xmi:id="ll_db" name="Cơ Sở Dữ Liệu" represents="lifeline_database"/>
      
      <!-- Messages -->
      <message xmi:type="uml:Message" xmi:id="msg_1" name="1. Truy cập trang thanh toán" messageSort="synchCall" sendEvent="send_1" receiveEvent="recv_1"/>
