      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_4" covered="ll_kh" message="msg_gh_4"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_4" covered="ll_sp" message="msg_gh_4"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_5" covered="ll_sp" message="msg_gh_5"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_5" covered="ll_gh" message="msg_gh_5"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_6" covered="ll_gh" message="msg_gh_6"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_6" covered="ll_ls" message="msg_gh_6"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_7" covered="ll_ls" message="msg_gh_7"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_7" covered="ll_gh" message="msg_gh_7"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_8" covered="ll_gh" message="msg_gh_8"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_8" covered="ll_gh" message="msg_gh_8"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_9" covered="ll_gh" message="msg_gh_9"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_9" covered="ll_ls" message="msg_gh_9"/>
