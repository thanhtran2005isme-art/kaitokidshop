      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_10" covered="ll_gh" message="msg_gh_10"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_11" covered="ll_gh" message="msg_gh_11"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_11" covered="ll_sp" message="msg_gh_11"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="send_gh_12" covered="ll_sp" message="msg_gh_12"/>
      <fragment xmi:type="uml:MessageOccurrenceSpecification" xmi:id="recv_gh_12" covered="ll_kh" message="msg_gh_12"/>
      
