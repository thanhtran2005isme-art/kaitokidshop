<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1">
  <xmi:Documentation exporter="KAITO KID Website" exporterVersion="1.0"/>
  
  <uml:Model xmi:type="uml:Model" xmi:id="model_1" name="Activity Diagram - Dat Hang">
    
    <!-- Activity Diagram -->
    <packagedElement xmi:type="uml:Activity" xmi:id="activity_dat_hang" name="Quy trinh Dat Hang - Website KAITO KID">
      
      <!-- ========== SWIMLANES (Partitions) ========== -->
      <group xmi:type="uml:ActivityPartition" xmi:id="partition_khach_hang" name="Khach hang"/>
      <group xmi:type="uml:ActivityPartition" xmi:id="partition_he_thong" name="He thong"/>
      
      <!-- ========== INITIAL NODE ========== -->
      <node xmi:type="uml:InitialNode" xmi:id="initial_node" name="Start" inPartition="partition_khach_hang"/>
      
      <!-- ========== ACTIVITY FINAL NODE ========== -->
      <node xmi:type="uml:ActivityFinalNode" xmi:id="final_node_1" name="End1" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="final_node_2" name="End2" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:ActivityFinalNode" xmi:id="final_node_3" name="End3" inPartition="partition_he_thong"/>
      
      <!-- ========== ACTIONS - KHACH HANG ========== -->
      <node xmi:type="uml:OpaqueAction" xmi:id="action_1" name="Truy cap gio hang" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_3" name="Quay lai mua sam" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_4" name="Kiem tra san pham trong gio" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_5" name="Nhan Tien hanh dat hang" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_7" name="Nhap thong tin nhan hang" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_9" name="Hien thi loi yeu cau nhap lai" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_10" name="Nhap lai thong tin" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_11" name="Chon phuong thuc thanh toan" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_13" name="Nhap ma giam gia" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_19" name="Xac nhan dat hang" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_24" name="Cap nhat gio hang" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_30" name="Xem thong tin don hang" inPartition="partition_khach_hang"/>
      
      <!-- ========== ACTIONS - HE THONG ========== -->
      <node xmi:type="uml:OpaqueAction" xmi:id="action_2" name="Hien thi danh sach san pham trong gio" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_6" name="Hien thi form thong tin dat hang" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_8" name="Kiem tra thong tin hop le" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_14" name="Kiem tra ma giam gia" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_15" name="Ap dung giam gia" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_16" name="Tinh lai tong tien" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_17" name="Thong bao ma khong hop le" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_18" name="Tinh tong tien don hang" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_18b" name="Hien thi thong tin don hang" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_20" name="Kiem tra ton kho" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_21" name="Xac thuc thong tin thanh toan" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_23" name="Thong bao san pham het hang" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_25" name="Tao don hang moi" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_26" name="Luu thong tin don hang" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_27" name="Cap nhat so luong ton kho" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_28" name="Xoa gio hang" inPartition="partition_he_thong"/>
      <node xmi:type="uml:OpaqueAction" xmi:id="action_29" name="Hien thi trang xac nhan thanh cong" inPartition="partition_he_thong"/>
      
      <!-- ========== DECISION NODES ========== -->
      <node xmi:type="uml:DecisionNode" xmi:id="decision_1" name="Gio hang trong?" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:DecisionNode" xmi:id="decision_2" name="Thong tin hop le?" inPartition="partition_he_thong"/>
      <node xmi:type="uml:DecisionNode" xmi:id="decision_3" name="Co ma giam gia?" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:DecisionNode" xmi:id="decision_4" name="Ma hop le?" inPartition="partition_he_thong"/>
      <node xmi:type="uml:DecisionNode" xmi:id="decision_5" name="Du hang trong kho?" inPartition="partition_he_thong"/>
      
      <!-- ========== MERGE NODES ========== -->
      <node xmi:type="uml:MergeNode" xmi:id="merge_1" name="Merge1" inPartition="partition_khach_hang"/>
      <node xmi:type="uml:MergeNode" xmi:id="merge_2" name="Merge2" inPartition="partition_he_thong"/>
      <node xmi:type="uml:MergeNode" xmi:id="merge_3" name="Merge3" inPartition="partition_he_thong"/>
      
      <!-- ========== FORK NODE ========== -->
      <node xmi:type="uml:ForkNode" xmi:id="fork_1" name="Fork1" inPartition="partition_he_thong"/>
      
      <!-- ========== JOIN NODE ========== -->
      <node xmi:type="uml:JoinNode" xmi:id="join_1" name="Join1" inPartition="partition_he_thong"/>
      
      <!-- ========== NOTES ========== -->
      <ownedComment xmi:type="uml:Comment" xmi:id="note_1" body="- Ho ten&#10;- So dien thoai&#10;- Email&#10;- Dia chi nhan hang" annotatedElement="action_7"/>
      <ownedComment xmi:type="uml:Comment" xmi:id="note_2" body="Tong = Tien hang + Phi van chuyen - Giam gia" annotatedElement="action_18"/>
      <ownedComment xmi:type="uml:Comment" xmi:id="note_3" body="- Ma don hang&#10;- Chi tiet san pham&#10;- Tong tien&#10;- Thoi gian giao hang du kien" annotatedElement="action_29"/>
     
 <!-- ========== CONTROL FLOWS (Edges) ========== -->
      <!-- Start -> Truy cap gio hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_1" name="" source="initial_node" target="action_1"/>
      
      <!-- Truy cap gio hang -> Hien thi danh sach -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_2" name="" source="action_1" target="action_2"/>
      
      <!-- Hien thi danh sach -> Decision gio hang trong -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_3" name="" source="action_2" target="decision_1"/>
      
      <!-- Decision gio hang trong -> Co -> Quay lai mua sam -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_4" name="Co" source="decision_1" target="action_3">
        <guard xmi:type="uml:LiteralString" value="Co"/>
      </edge>
      
      <!-- Quay lai mua sam -> End1 -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_5" name="" source="action_3" target="final_node_1"/>
      
      <!-- Decision gio hang trong -> Khong -> Kiem tra san pham -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_6" name="Khong" source="decision_1" target="action_4">
        <guard xmi:type="uml:LiteralString" value="Khong"/>
      </edge>
      
      <!-- Kiem tra san pham -> Nhan tien hanh dat hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_7" name="" source="action_4" target="action_5"/>
      
      <!-- Nhan tien hanh -> Hien thi form -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_8" name="" source="action_5" target="action_6"/>
      
      <!-- Hien thi form -> Nhap thong tin -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_9" name="" source="action_6" target="action_7"/>
      
      <!-- Nhap thong tin -> Kiem tra hop le -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_10" name="" source="action_7" target="action_8"/>
      
      <!-- Kiem tra hop le -> Decision thong tin hop le -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_11" name="" source="action_8" target="decision_2"/>
      
      <!-- Decision thong tin hop le -> Khong -> Hien thi loi -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_12" name="Khong" source="decision_2" target="action_9">
        <guard xmi:type="uml:LiteralString" value="Khong"/>
      </edge>
      
      <!-- Hien thi loi -> Nhap lai -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_13" name="" source="action_9" target="action_10"/>
      
      <!-- Nhap lai -> Kiem tra hop le (loop back) -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_14" name="" source="action_10" target="action_8"/>
      
      <!-- Decision thong tin hop le -> Co -> Chon phuong thuc -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_15" name="Co" source="decision_2" target="action_11">
        <guard xmi:type="uml:LiteralString" value="Co"/>
      </edge>
      
      <!-- Chon phuong thuc -> Decision co ma giam gia -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_16" name="" source="action_11" target="decision_3"/>
    
  <!-- Decision co ma giam gia -> Co -> Nhap ma -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_17" name="Co" source="decision_3" target="action_13">
        <guard xmi:type="uml:LiteralString" value="Co"/>
      </edge>
      
      <!-- Nhap ma -> Kiem tra ma -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_18" name="" source="action_13" target="action_14"/>
      
      <!-- Kiem tra ma -> Decision ma hop le -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_19" name="" source="action_14" target="decision_4"/>
      
      <!-- Decision ma hop le -> Co -> Ap dung giam gia -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_20" name="Co" source="decision_4" target="action_15">
        <guard xmi:type="uml:LiteralString" value="Co"/>
      </edge>
      
      <!-- Ap dung giam gia -> Tinh lai tong tien -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_21" name="" source="action_15" target="action_16"/>
      
      <!-- Tinh lai tong tien -> Merge2 -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_22" name="" source="action_16" target="merge_2"/>
      
      <!-- Decision ma hop le -> Khong -> Thong bao khong hop le -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_23" name="Khong" source="decision_4" target="action_17">
        <guard xmi:type="uml:LiteralString" value="Khong"/>
      </edge>
      
      <!-- Thong bao khong hop le -> Merge2 -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_24" name="" source="action_17" target="merge_2"/>
      
      <!-- Decision co ma giam gia -> Khong -> Merge2 -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_25" name="Khong" source="decision_3" target="merge_2">
        <guard xmi:type="uml:LiteralString" value="Khong"/>
      </edge>
      
      <!-- Merge2 -> Tinh tong tien don hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_26" name="" source="merge_2" target="action_18"/>
      
      <!-- Tinh tong tien -> Hien thi thong tin don hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_27" name="" source="action_18" target="action_18b"/>
      
      <!-- Hien thi thong tin -> Xac nhan dat hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_28" name="" source="action_18b" target="action_19"/>
      
      <!-- Xac nhan dat hang -> Fork -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_29" name="" source="action_19" target="fork_1"/>
      
      <!-- Fork -> Kiem tra ton kho -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_30" name="" source="fork_1" target="action_20"/>
      
      <!-- Fork -> Xac thuc thanh toan -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_31" name="" source="fork_1" target="action_21"/>
      
      <!-- Kiem tra ton kho -> Join -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_32" name="" source="action_20" target="join_1"/>
      
      <!-- Xac thuc thanh toan -> Join -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_33" name="" source="action_21" target="join_1"/>
      
      <!-- Join -> Decision du hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_34" name="" source="join_1" target="decision_5"/>
      <
!-- Decision du hang -> Khong -> Thong bao het hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_35" name="Khong" source="decision_5" target="action_23">
        <guard xmi:type="uml:LiteralString" value="Khong"/>
      </edge>
      
      <!-- Thong bao het hang -> Cap nhat gio hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_36" name="" source="action_23" target="action_24"/>
      
      <!-- Cap nhat gio hang -> End2 -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_37" name="" source="action_24" target="final_node_2"/>
      
      <!-- Decision du hang -> Co -> Tao don hang moi -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_38" name="Co" source="decision_5" target="action_25">
        <guard xmi:type="uml:LiteralString" value="Co"/>
      </edge>
      
      <!-- Tao don hang moi -> Luu thong tin -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_39" name="" source="action_25" target="action_26"/>
      
      <!-- Luu thong tin -> Cap nhat ton kho -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_40" name="" source="action_26" target="action_27"/>
      
      <!-- Cap nhat ton kho -> Xoa gio hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_41" name="" source="action_27" target="action_28"/>
      
      <!-- Xoa gio hang -> Hien thi thanh cong -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_42" name="" source="action_28" target="action_29"/>
      
      <!-- Hien thi thanh cong -> Xem thong tin don hang -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_43" name="" source="action_29" target="action_30"/>
      
      <!-- Xem thong tin don hang -> End3 -->
      <edge xmi:type="uml:ControlFlow" xmi:id="flow_44" name="" source="action_30" target="final_node_3"/>
      
    </packagedElement>
  </uml:Model>
  
