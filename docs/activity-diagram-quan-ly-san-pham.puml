@startuml Biểu đồ hành động - Quản lý sản phẩm
!theme plain
skinparam backgroundColor #FFFFFF
skinparam activity {
    BackgroundColor #87CEEB
    BorderColor #000000
    ArrowColor #000000
}

title Biểu đồ hành động (Activity Diagram)\nChức năng: Quản lý sản phẩm\nWebsite bán quần áo KAITO KID

|#LightBlue| Admin |
|#LightGreen| Hệ thống |

|Admin|
start

:Đăng nhập hệ thống quản trị;

|Hệ thống|
:Xác thực quyền Admin;

if (Xác thực thành công?) then (Không)
    :Thông báo lỗi đăng nhập;
    stop
else (Có)
endif

:Hiển thị trang quản lý sản phẩm;
:Tải danh sách sản phẩm;

|Admin|
:Chọn thao tác;

switch (Thao tác?)
case (Thêm mới)
    :Nhấn "Thêm sản phẩm";
    
    |Hệ thống|
    :Hiển thị form thêm sản phẩm;
    
    |Admin|
    :Nhập thông tin sản phẩm;
    note right
      - Tên sản phẩm
      - Mã SKU
      - Danh mục
      - Giá bán
      - Giá gốc
      - Mô tả
      - Kích thước
      - Màu sắc
      - Số lượng tồn kho
    end note
    
    :Upload hình ảnh sản phẩm;
    :Nhấn "Lưu";
    
    |Hệ thống|
    :Kiểm tra dữ liệu hợp lệ;
    
    if (Dữ liệu hợp lệ?) then (Không)
        :Hiển thị thông báo lỗi;
        |Admin|
        :Sửa thông tin;
    else (Có)
        :Lưu sản phẩm vào CSDL;
        :Thông báo thêm thành công;
    endif

case (Sửa)
    :Chọn sản phẩm cần sửa;
    :Nhấn "Sửa";
    
    |Hệ thống|
    :Tải thông tin sản phẩm;
    :Hiển thị form chỉnh sửa;
    
    |Admin|
    :Cập nhật thông tin;
    :Nhấn "Cập nhật";
    
    |Hệ thống|
    :Kiểm tra dữ liệu hợp lệ;
    
    if (Dữ liệu hợp lệ?) then (Không)
        :Hiển thị thông báo lỗi;
        |Admin|
        :Sửa thông tin;
    else (Có)
        :Cập nhật sản phẩm trong CSDL;
        :Thông báo cập nhật thành công;
    endif

case (Xóa)
    :Chọn sản phẩm cần xóa;
    :Nhấn "Xóa";
    
    |Hệ thống|
    :Hiển thị xác nhận xóa;
    
    |Admin|
    if (Xác nhận xóa?) then (Không)
        :Hủy thao tác;
    else (Có)
        |Hệ thống|
        :Kiểm tra ràng buộc dữ liệu;
        
        if (Có đơn hàng liên quan?) then (Có)
            :Thông báo không thể xóa;
            :Đề xuất ẩn sản phẩm;
        else (Không)
            :Xóa sản phẩm khỏi CSDL;
            :Thông báo xóa thành công;
        endif
    endif

case (Tìm kiếm)
    :Nhập từ khóa tìm kiếm;
    :Chọn bộ lọc;
    note right
      - Theo danh mục
      - Theo giá
      - Theo trạng thái
      - Theo tồn kho
    end note
    
    |Hệ thống|
    :Truy vấn CSDL;
    :Hiển thị kết quả tìm kiếm;

endswitch

|Hệ thống|
:Cập nhật danh sách sản phẩm;

|Admin|
:Xem kết quả;

if (Tiếp tục quản lý?) then (Có)
    :Chọn thao tác;
    detach
else (Không)
endif

:Đăng xuất;

stop

@enduml
