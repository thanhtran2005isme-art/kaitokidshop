@startuml Biểu đồ lớp chi tiết - UC NhapHDBan
!theme plain
skinparam backgroundColor #FFFFFF
skinparam class {
    BackgroundColor #87CEEB
    BorderColor #000000
    ArrowColor #000000
}

title Biểu đồ lớp chi tiết mức thiết kế\nUse Case: Nhập Hóa Đơn Bán (NhapHDBan)\nWebsite bán quần áo KAITO KID

' ===== LỚP BOUNDARY (GIAO DIỆN) =====
class FrmQuanLyBanHang <<boundary>> {
    ' Thuộc tính giao diện
    -txtMaHoaDon : TextBox
    -txtMaKhachHang : TextBox
    -txtMaSanPham : TextBox
    -txtSoLuong : TextBox
    -txtDonGia : TextBox
    -txtThanhTien : TextBox
    -txtTongTien : TextBox
    -dgvChiTietHDB : DataGridView
    -cboMaGiamGia : ComboBox
    -dtpNgayBan : DateTimePicker
    -btnThemSP : Button
    -btnXoaSP : Button
    -btnLuuHDB : Button
    -btnHuy : Button
    --
    ' Phương thức giao diện (từ biểu đồ tuần tự)
    +ChonChucNangBanHang() : void
    +NhapMaHang(maHang : string) : void
    +NhapSoLuong(soLuong : int) : void
    +NhapMaKhachHang(maKH : string) : void
    +HienThiThongTinSP(sp : HangHoa) : void
    +HienThiChiTietHDB(ctList : CTHDB[]) : void
    +HienThiTongTien(tongTien : decimal) : void
    +HienThiThongBao(message : string) : void
    +HienThiMaHoaDon(maHDB : string) : void
    +XacNhanLuuHDB() : boolean
    +ResetForm() : void
}

' ===== LỚP CONTROL (ĐIỀU KHIỂN) =====
class Ctr_QuanLyBanHang <<control>> {
    ' Thuộc tính điều khiển
    -hoaDonHienTai : HoaDonBan
    -danhSachCTHDB : CTHDB[]
    -tongTienTamTinh : decimal
    --
    ' Phương thức điều khiển (từ biểu đồ tuần tự)
    +SinhMaHoaDon(ngayThang : string) : string
    +LayThongTinHangBan(maHang : string) : HangHoa
    +BanHang(hoaDon : HoaDonBan, danhSachHangBan : CTHDB[]) : boolean
    +TinhTongTien(danhSachCT : CTHDB[]) : decimal
    +KiemTraTonKho(maHang : string, soLuong : int) : boolean
    +ApDungMaGiamGia(maGG : string, tongTien : decimal) : decimal
    +LayGiaHienTai(maHang : string) : decimal
    +ThemChiTietHDB(ct : CTHDB) : boolean
    +XoaChiTietHDB(maHang : string) : boolean
    +CapNhatTonKho(maHang : string, soLuong : int) : boolean
    +LayThongTinKhachHang(maKH : string) : KhachHang
    +TaoHoaDonMoi() : HoaDonBan
}

' ===== LỚP ENTITY: HÓA ĐƠN BÁN =====
class HoaDonBan <<entity>> {
    ' Thuộc tính
    -MaHDB : string
    -MaKH : string
    -MaNV : string
    -NgayBan : datetime
    -TongTien : decimal
    -GiamGia : decimal
    -ThanhTien : decimal
    -TrangThai : string
    -GhiChu : string
    --
    ' Phương thức (từ biểu đồ tuần tự)
    +LayHoaDonCungNgay(ngay : date) : HoaDonBan[]
    +LuuHoaDon() : boolean
    +CapNhatTrangThai(trangThai : string) : boolean
    +TinhThanhTien() : decimal
    +LayChiTietHDB() : CTHDB[]
}

' ===== LỚP ENTITY: CHI TIẾT HÓA ĐƠN BÁN =====
class CTHDB <<entity>> {
    ' Thuộc tính
    -MaHDB : string
    -MaHang : string
    -SoLuong : int
    -DonGia : decimal
    -ThanhTien : decimal
    -KichThuoc : string
    -MauSac : string
    --
    ' Phương thức
    +TinhThanhTien() : decimal
    +LuuChiTiet() : boolean
    +CapNhatSoLuong(soLuong : int) : boolean
}

' ===== LỚP ENTITY: HÀNG HÓA (SẢN PHẨM) =====
class HangHoa <<entity>> {
    ' Thuộc tính
    -MaHang : string
    -MaLoai : string
    -TenHang : string
    -SoLuong : int
    -SoLuongCon : int
    -DonViTinh : string
    -HinhAnh : string
    -MoTa : string
    --
    ' Phương thức (từ biểu đồ tuần tự)
    +LayHangHoa(maHang : string) : HangHoa
    +CapNhatSoLuong(soLuongMoi : int) : boolean
    +KiemTraTonKho() : int
    +LayDanhSachHangHoa() : HangHoa[]
}

' ===== LỚP ENTITY: GIÁ BÁN =====
class GiaBan <<entity>> {
    ' Thuộc tính
    -MaGB : string
    -MaHang : string
    -Gia : decimal
    -DVTinh : string
    -NgayBD : date
    -NgayKT : date
    -TrangThai : string
    --
    ' Phương thức
    +LayGiaHienTai(maHang : string) : decimal
    +LayLichSuGia(maHang : string) : GiaBan[]
    +KiemTraGiaConHieuLuc() : boolean
    +CapNhatGia(giaMoi : decimal) : boolean
}

' ===== LỚP ENTITY: KHÁCH HÀNG =====
class KhachHang <<entity>> {
    ' Thuộc tính
    -MaKH : string
    -HoTen : string
    -SoDienThoai : string
    -Email : string
    -DiaChi : string
    -HangThanhVien : string
    -DiemTichLuy : int
    --
    ' Phương thức
    +LayThongTinKH(maKH : string) : KhachHang
    +CapNhatDiemTichLuy(diem : int) : boolean
    +LayHangThanhVien() : string
}

' ===== LỚP ENTITY: MÃ GIẢM GIÁ =====
class MaGiamGia <<entity>> {
    ' Thuộc tính
    -MaGG : string
    -TenMa : string
    -LoaiGiam : string
    -GiaTriGiam : decimal
    -DonToiThieu : decimal
    -NgayBD : date
    -NgayKT : date
    -SoLuong : int
    -DaSuDung : int
    --
    ' Phương thức
    +KiemTraHopLe(tongTien : decimal) : boolean
    +TinhGiamGia(tongTien : decimal) : decimal
    +CapNhatSoLuongDung() : boolean
}

' ========================================
' ===== CÁC MỐI QUAN HỆ =====
' ========================================

' Boundary -> Control (Association)
FrmQuanLyBanHang --> Ctr_QuanLyBanHang : <<uses>>

' Control -> Entity (Dependencies)
Ctr_QuanLyBanHang ..> HoaDonBan : <<creates/uses>>
Ctr_QuanLyBanHang ..> CTHDB : <<creates/uses>>
Ctr_QuanLyBanHang ..> HangHoa : <<uses>>
Ctr_QuanLyBanHang ..> GiaBan : <<uses>>
Ctr_QuanLyBanHang ..> KhachHang : <<uses>>
Ctr_QuanLyBanHang ..> MaGiamGia : <<uses>>

' Entity Relationships
HoaDonBan "1" *-- "0..*" CTHDB : CTHDBan >
CTHDB "0..*" -- "1" HangHoa : tham chiếu >
HangHoa "1" -- "1..*" GiaBan : có giá >
HoaDonBan "0..*" -- "1" KhachHang : thuộc về >
HoaDonBan "0..1" -- "0..1" MaGiamGia : áp dụng >

' Ghi chú
note right of FrmQuanLyBanHang
  <b>Lớp Boundary</b>
  Giao diện người dùng
  cho chức năng bán hàng
end note

note right of Ctr_QuanLyBanHang
  <b>Lớp Control</b>
  Xử lý logic nghiệp vụ
  bán hàng và tạo hóa đơn
end note

note bottom of HoaDonBan
  <b>Lớp Entity</b>
  Lưu trữ thông tin
  hóa đơn bán hàng
end note

@enduml
