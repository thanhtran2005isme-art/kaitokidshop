@startuml BDTT_DangNhap
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center

title Biểu đồ tuần tự: Đăng nhập\nWebsite bán quần áo KAITO KID

actor "Người dùng" as USER
boundary "GiaoDienDangNhap\n<<boundary>>" as UI
control "AuthController\n<<control>>" as AUTH
entity "TaiKhoanAdmin\n<<entity>>" as ADMIN
entity "TaiKhoanUser\n<<entity>>" as USERS

== Luồng chính: Đăng nhập thành công ==

USER -> UI : 1. Nhập email/SĐT và mật khẩu
activate UI

UI -> UI : 1.1. validateInput()
note right: Kiểm tra:\n- Email/SĐT không rỗng\n- Mật khẩu không rỗng

UI -> AUTH : 1.2. handleLogin(email, password)
activate AUTH

AUTH -> ADMIN : 1.2.1. checkAdminCredentials(email, password)
activate ADMIN
ADMIN -> ADMIN : compare(email, password)
ADMIN --> AUTH : 1.2.2. return isAdmin
deactivate ADMIN

alt Là tài khoản Admin
    AUTH -> AUTH : 1.2.3a. createAdminSession()
    AUTH --> UI : 1.3a. return {success, role: 'admin'}
else Không phải Admin
    AUTH -> USERS : 1.2.3b. findUser(email, password)
    activate USERS
    USERS -> USERS : users.find(u => u.email === email)
    USERS --> AUTH : 1.2.4. return userData
    deactivate USERS
    
    alt Tìm thấy user
        AUTH -> AUTH : 1.2.5a. createUserSession()
        AUTH --> UI : 1.3b. return {success, role: 'user'}
    else Không tìm thấy
        AUTH --> UI : 1.3c. return {error: 'Sai thông tin'}
    end
end
deactivate AUTH

alt Đăng nhập thành công
    UI -> UI : 1.4. saveLoginState()
    note right: localStorage:\n- currentUser\n- userLoggedIn = true\n- userType
    UI --> USER : 1.5. Chuyển hướng về trang chủ
else Đăng nhập thất bại
    UI --> USER : 1.5. Hiển thị lỗi:\n"Email/SĐT hoặc mật khẩu không đúng"
end
deactivate UI

== Luồng thay thế: Đăng ký tài khoản mới ==

USER -> UI : 2. Chuyển tab "Đăng ký"
activate UI
UI -> UI : 2.1. switchTab('register')
UI --> USER : 2.2. Hiển thị form đăng ký
deactivate UI

USER -> UI : 3. Nhập thông tin đăng ký
activate UI

UI -> UI : 3.1. validateRegisterForm()
note right: Kiểm tra:\n- Họ tên không rỗng\n- Email hợp lệ\n- SĐT 10-11 số\n- Mật khẩu >= 6 ký tự\n- Xác nhận MK khớp

UI -> AUTH : 3.2. handleRegister(userData)
activate AUTH

AUTH -> USERS : 3.2.1. checkEmailExists(email)
activate USERS
USERS --> AUTH : 3.2.2. return exists
deactivate USERS

alt Email đã tồn tại
    AUTH --> UI : 3.3a. return {error: 'Email đã đăng ký'}
else Email chưa tồn tại
    AUTH -> USERS : 3.3b. createUser(userData)
    activate USERS
    USERS -> USERS : users.push(newUser)
    USERS -> USERS : localStorage.setItem('users', ...)
    USERS --> AUTH : 3.3.1. return success
    deactivate USERS
    AUTH --> UI : 3.4. return {success: true}
end
deactivate AUTH

alt Đăng ký thành công
    UI --> USER : 3.5a. "Đăng ký thành công!"\nChuyển về tab Đăng nhập
else Đăng ký thất bại
    UI --> USER : 3.5b. Hiển thị lỗi
end
deactivate UI

== Luồng: Đăng xuất ==

USER -> UI : 4. Nhấn "Đăng xuất"
activate UI
UI -> AUTH : 4.1. handleLogout()
activate AUTH
AUTH -> AUTH : 4.1.1. clearSession()
note right: localStorage.removeItem:\n- currentUser\n- userLoggedIn\n- userType\n- adminLoggedIn
AUTH --> UI : 4.2. return success
deactivate AUTH
UI --> USER : 4.3. Chuyển về trang đăng nhập
deactivate UI

@enduml
