@startuml BDTT_DatHang
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

title Biểu đồ tuần tự: Đặt hàng (Place Order)\nWebsite bán quần áo KAITO KID

actor "Khách hàng" as KH
boundary "GiaoDienThanhToan\n<<boundary>>" as UI
control "CheckoutController\n<<control>>" as CTRL
entity "GioHang\n<<entity>>" as CART
entity "MaGiamGia\n<<entity>>" as COUPON
entity "DonHang\n<<entity>>" as ORDER
entity "TonKho\n<<entity>>" as INV

== Luồng chính: Đặt hàng thành công ==

KH -> UI : 1. Nhập thông tin đặt hàng\n(tên, SĐT, địa chỉ, PTTT)
activate UI

UI -> UI : 1.1. validateForm()
note right: Kiểm tra:\n- Tên không rỗng\n- SĐT hợp lệ\n- Địa chỉ đầy đủ

UI -> CTRL : 1.2. placeOrder(customerInfo, cart)
activate CTRL

CTRL -> CART : 1.2.1. getCart()
activate CART
CART --> CTRL : 1.2.2. return cartItems[]
deactivate CART

alt Có mã giảm giá
    CTRL -> COUPON : 1.2.3. validateCoupon(code)
    activate COUPON
    
    COUPON -> COUPON : checkExpiry()
    COUPON -> COUPON : checkMinOrder()
    COUPON -> COUPON : checkUsageLimit()
    
    COUPON --> CTRL : 1.2.4. return discountAmount
    deactivate COUPON
end

CTRL -> CTRL : 1.2.5. calculateTotal()\n- subtotal\n- discount\n- shipping\n- total

CTRL -> ORDER : 1.2.6. createOrder(orderData)
activate ORDER

ORDER -> ORDER : 1.2.6.1. save()
note right: Lưu vào localStorage:\n- orderId = Date.now()\n- status = 'pending'\n- paymentStatus

ORDER --> CTRL : 1.2.7. return orderId
deactivate ORDER

CTRL -> INV : 1.2.8. updateInventory(items)
activate INV

loop Với mỗi sản phẩm trong đơn
    INV -> INV : 1.2.8.1. reduceStock(productId, qty)
    INV -> INV : logInventoryHistory()
end

INV --> CTRL : 1.2.9. return success
deactivate INV

opt Có sử dụng mã giảm giá
    CTRL -> COUPON : 1.2.10. updateCouponUsage(code)
    activate COUPON
    COUPON -> COUPON : used++
    deactivate COUPON
end

CTRL -> CART : 1.2.11. clearCart()
activate CART
CART -> CART : localStorage.setItem('cart', '[]')
deactivate CART

CTRL --> UI : 1.3. return orderResult\n{success: true, orderId}
deactivate CTRL

UI --> KH : 1.4. Hiển thị: "Đặt hàng thành công!"\nMã đơn hàng: #orderId
deactivate UI

== Luồng thay thế: Giỏ hàng trống ==

KH -> UI : 2. Nhấn "Đặt hàng"
activate UI
UI -> CTRL : 2.1. placeOrder()
activate CTRL
CTRL -> CART : 2.1.1. getCart()
activate CART
CART --> CTRL : 2.1.2. return []
deactivate CART
CTRL --> UI : 2.2. return {error: "Giỏ hàng trống"}
deactivate CTRL
UI --> KH : 2.3. Hiển thị: "Giỏ hàng trống!"
deactivate UI

== Luồng thay thế: Thông tin không hợp lệ ==

KH -> UI : 3. Nhập thông tin thiếu
activate UI
UI -> UI : 3.1. validateForm() = false
UI --> KH : 3.2. Hiển thị lỗi:\n"Vui lòng nhập đầy đủ thông tin"
deactivate UI

@enduml
