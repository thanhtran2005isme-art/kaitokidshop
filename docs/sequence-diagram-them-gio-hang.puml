@startuml BDTT_ThemGioHang
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center

title Biểu đồ tuần tự: Thêm sản phẩm vào giỏ hàng\nWebsite bán quần áo KAITO KID

actor "Khách hàng" as KH
boundary "GiaoDienChiTietSP\n<<boundary>>" as UI
control "ProductController\n<<control>>" as CTRL
entity "SanPham\n<<entity>>" as PRODUCT
entity "GioHang\n<<entity>>" as CART
entity "FlashSale\n<<entity>>" as FLASH

== Luồng chính: Thêm sản phẩm vào giỏ ==

KH -> UI : 1. Xem chi tiết sản phẩm
activate UI

UI -> CTRL : 1.1. loadProduct(productId)
activate CTRL

CTRL -> PRODUCT : 1.1.1. getProductById(id)
activate PRODUCT
PRODUCT --> CTRL : 1.1.2. return productData
deactivate PRODUCT

CTRL -> FLASH : 1.1.3. checkFlashSale(productId)
activate FLASH
FLASH -> FLASH : findActiveFlashSale()
FLASH --> CTRL : 1.1.4. return flashSaleDiscount
deactivate FLASH

CTRL --> UI : 1.2. return product + flashSaleInfo
deactivate CTRL

UI --> KH : 1.3. Hiển thị thông tin sản phẩm\n(tên, giá, màu, size, tồn kho)

KH -> UI : 2. Chọn màu sắc
activate UI
UI -> UI : 2.1. selectColor(color)\nupdateStockStatus()
UI --> KH : 2.2. Cập nhật UI (size khả dụng)
deactivate UI

KH -> UI : 3. Chọn kích thước
activate UI
UI -> UI : 3.1. selectSize(size)\nupdateStockStatus()
UI --> KH : 3.2. Hiển thị số lượng tồn kho
deactivate UI

KH -> UI : 4. Chọn số lượng
activate UI
UI -> UI : 4.1. validateQuantity(qty, maxStock)
alt qty > maxStock
    UI --> KH : 4.2a. Cảnh báo: "Chỉ còn X sản phẩm"
else qty <= maxStock
    UI --> KH : 4.2b. Cập nhật số lượng
end
deactivate UI

KH -> UI : 5. Nhấn "Thêm vào giỏ"
activate UI

UI -> CTRL : 5.1. addToCart(cartItem)
activate CTRL

CTRL -> CART : 5.1.1. getCart()
activate CART
CART --> CTRL : 5.1.2. return currentCart[]
deactivate CART

CTRL -> CTRL : 5.1.3. checkExistingItem()\n(id + color + size)

alt Sản phẩm đã có trong giỏ
    CTRL -> CTRL : 5.1.4a. cart[index].quantity += qty
else Sản phẩm chưa có
    CTRL -> CTRL : 5.1.4b. cart.push(newItem)
end

CTRL -> CART : 5.1.5. saveCart(cart)
activate CART
CART -> CART : localStorage.setItem('cart', JSON.stringify(cart))
CART --> CTRL : 5.1.6. return success
deactivate CART

CTRL --> UI : 5.2. return {success: true}
deactivate CTRL

UI -> UI : 5.3. updateCartCount()
UI --> KH : 5.4. Thông báo: "Đã thêm vào giỏ hàng!"
deactivate UI

== Luồng thay thế: Sản phẩm hết hàng ==

KH -> UI : 6. Nhấn "Thêm vào giỏ" (hết hàng)
activate UI
UI -> UI : 6.1. checkStock() = 0
UI --> KH : 6.2. Nút bị disable\n"Sản phẩm đang tạm hết hàng"
deactivate UI

@enduml
