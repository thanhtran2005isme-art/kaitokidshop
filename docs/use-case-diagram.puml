@startuml Use Case Diagram - Website Thời Trang

skinparam backgroundColor #87CEEB
skinparam usecase {
    BackgroundColor #87CEEB
    BorderColor #000000
}
skinparam rectangle {
    BackgroundColor #87CEEB
    BorderColor #000000
}

left to right direction

' ===== ACTORS =====
actor "Khách hàng" as Customer
actor "Admin" as Admin

Customer <|-- Admin

' ===== SYSTEM =====
rectangle "System" {
    
    ' === CUSTOMER USE CASES ===
    usecase "Tìm kiếm" as UC_Search
    usecase "Đăng ký" as UC_Register
    usecase "Quản lý tài khoản" as UC_Account
    usecase "Xem sản phẩm\ntheo danh mục" as UC_ViewCategory
    usecase "Xem Lookbook" as UC_Lookbook
    usecase "Xem Bộ sưu tập" as UC_Collection
    usecase "Quản lý giỏ hàng" as UC_Cart
    usecase "Áp dụng\nmã giảm giá" as UC_ApplyCoupon
    usecase "Đặt hàng và\nthanh toán" as UC_Checkout
    usecase "Theo dõi và\nhủy đơn hàng" as UC_TrackOrder
    
    ' === ADMIN USE CASES ===
    usecase "Quản lý\nsản phẩm" as UC_ManageProducts
    usecase "Quản lý\ndanh mục" as UC_ManageCategories
    usecase "Quản lý\nkhách hàng" as UC_ManageCustomers
    usecase "Quản lý\nđơn hàng" as UC_ManageOrders
    usecase "Quản lý\nkho hàng" as UC_ManageInventory
    usecase "Quản lý\nkhuyến mãi" as UC_ManagePromotions
    usecase "Quản lý\nFlash Sale" as UC_ManageFlashSale
    usecase "Quản lý\nmã giảm giá" as UC_ManageCoupons
    usecase "Quản lý\nMenu" as UC_ManageMenus
    usecase "Quản lý\ntrang chủ" as UC_ManageHomepage
    usecase "Cài đặt\nhệ thống" as UC_Settings
    usecase "Thống kê -\nBáo cáo" as UC_Reports
    
    ' === SHARED ===
    usecase "Đăng nhập" as UC_Login
}

' ===== CUSTOMER RELATIONSHIPS =====
Customer --> UC_Search
Customer --> UC_Register
Customer --> UC_Account
Customer --> UC_ViewCategory
Customer --> UC_Lookbook
Customer --> UC_Collection
Customer --> UC_Cart
Customer --> UC_ApplyCoupon
Customer --> UC_Checkout
Customer --> UC_TrackOrder

' ===== ADMIN RELATIONSHIPS =====
Admin --> UC_ManageProducts
Admin --> UC_ManageCategories
Admin --> UC_ManageCustomers
Admin --> UC_ManageOrders
Admin --> UC_ManageInventory
Admin --> UC_ManagePromotions
Admin --> UC_ManageFlashSale
Admin --> UC_ManageCoupons
Admin --> UC_ManageMenus
Admin --> UC_ManageHomepage
Admin --> UC_Settings
Admin --> UC_Reports

' ===== INCLUDE RELATIONSHIPS =====
UC_Account ..> UC_Login : <<include>>
UC_Cart ..> UC_Login : <<include>>
UC_Checkout ..> UC_Login : <<include>>
UC_TrackOrder ..> UC_Login : <<include>>
UC_ManageProducts ..> UC_Login : <<include>>
UC_ManageCategories ..> UC_Login : <<include>>
UC_ManageCustomers ..> UC_Login : <<include>>
UC_ManageOrders ..> UC_Login : <<include>>
UC_ManageInventory ..> UC_Login : <<include>>
UC_ManagePromotions ..> UC_Login : <<include>>
UC_ManageFlashSale ..> UC_Login : <<include>>
UC_ManageCoupons ..> UC_Login : <<include>>
UC_Reports ..> UC_Login : <<include>>

@enduml
