@startuml Use Case - Quản lý Danh mục

skinparam backgroundColor #87CEEB
skinparam usecase {
    BackgroundColor #87CEEB
    BorderColor #000000
}

left to right direction

actor "Admin" as Admin

rectangle "Quản lý Danh mục" {
    usecase "Quản lý\ndanh mục" as UC_Main
    
    usecase "Xem danh sách\ndanh mục" as UC_ViewList
    usecase "Thêm danh mục" as UC_Add
    usecase "Cập nhật\ndanh mục" as UC_Edit
    usecase "Xóa danh mục" as UC_Delete
    usecase "Tìm kiếm\ndanh mục" as UC_Search
    usecase "Quản lý\ndanh mục con" as UC_SubCategory
    usecase "Sắp xếp\nthứ tự" as UC_Sort
    usecase "Cập nhật\ntrạng thái" as UC_Status
}

' Main connection
Admin --> UC_Main

' Extend relationships
UC_ViewList .up.> UC_Main : <<extend>>
UC_Add .up.> UC_Main : <<extend>>
UC_Edit .up.> UC_Main : <<extend>>
UC_Delete .down.> UC_Main : <<extend>>
UC_Search .down.> UC_Main : <<extend>>

' Include relationships
UC_Add ..> UC_SubCategory : <<include>>
UC_Edit ..> UC_SubCategory : <<include>>
UC_Edit ..> UC_Status : <<include>>
UC_ViewList ..> UC_Sort : <<include>>

@enduml
