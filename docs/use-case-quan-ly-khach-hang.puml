@startuml Use Case - Quản lý Khách hàng

skinparam backgroundColor #87CEEB
skinparam usecase {
    BackgroundColor #87CEEB
    BorderColor #000000
}

left to right direction

actor "Admin" as Admin

rectangle "Quản lý Khách hàng" {
    usecase "Quản lý\nkhách hàng" as UC_Main
    
    usecase "Xem danh sách\nkhách hàng" as UC_ViewList
    usecase "Thêm khách\nhàng mới" as UC_Add
    usecase "Cập nhật thông\ntin khách hàng" as UC_Edit
    usecase "Xóa khách hàng" as UC_Delete
    usecase "Tìm kiếm\nkhách hàng" as UC_Search
    usecase "Xem chi tiết\nkhách hàng" as UC_ViewDetail
    usecase "Lọc theo hạng\n(VIP/Thường/Mới)" as UC_FilterTier
    usecase "Lọc theo\ntrạng thái" as UC_FilterStatus
    usecase "Xuất Excel" as UC_Export
    usecase "Xem thống kê\nmua hàng" as UC_Stats
}

' Main connection
Admin --> UC_Main

' Extend relationships
UC_ViewList .up.> UC_Main : <<extend>>
UC_Add .up.> UC_Main : <<extend>>
UC_Edit .up.> UC_Main : <<extend>>
UC_Delete .down.> UC_Main : <<extend>>
UC_Search .down.> UC_Main : <<extend>>
UC_ViewDetail .down.> UC_Main : <<extend>>
UC_Export .down.> UC_Main : <<extend>>

' Include relationships
UC_ViewList ..> UC_FilterTier : <<include>>
UC_ViewList ..> UC_FilterStatus : <<include>>
UC_ViewDetail ..> UC_Stats : <<include>>

@enduml
