@startuml Use Case - Quản lý Khuyến mãi

skinparam backgroundColor #87CEEB
skinparam usecase {
    BackgroundColor #87CEEB
    BorderColor #000000
}

left to right direction

actor "Admin" as Admin

rectangle "Quản lý Khuyến mãi" {
    usecase "Quản lý\nkhuyến mãi" as UC_Main
    
    ' === MÃ GIẢM GIÁ (COUPONS) ===
    usecase "Quản lý\nmã giảm giá" as UC_Coupons
    usecase "Tạo mã\ngiảm giá" as UC_AddCoupon
    usecase "Sửa mã\ngiảm giá" as UC_EditCoupon
    usecase "Xóa mã\ngiảm giá" as UC_DeleteCoupon
    usecase "Sao chép mã" as UC_CopyCoupon
    
    ' === CHƯƠNG TRÌNH KHUYẾN MÃI ===
    usecase "Quản lý chương\ntrình KM" as UC_Promotions
    usecase "Tạo chương\ntrình KM" as UC_AddPromo
    usecase "Sửa chương\ntrình KM" as UC_EditPromo
    usecase "Xóa chương\ntrình KM" as UC_DeletePromo
    usecase "Thiết lập thời\ngian KM" as UC_SetTime
    usecase "Chọn sản phẩm\náp dụng" as UC_SelectProducts
    
    ' === FLASH SALE ===
    usecase "Quản lý\nFlash Sale" as UC_FlashSale
    usecase "Tạo Flash Sale" as UC_AddFlash
    usecase "Sửa Flash Sale" as UC_EditFlash
    usecase "Xóa Flash Sale" as UC_DeleteFlash
    usecase "Thiết lập\nđếm ngược" as UC_Countdown
    usecase "Chọn SP\nFlash Sale" as UC_SelectFlashProducts
    
    ' === THỐNG KÊ ===
    usecase "Xem thống kê\nkhuyến mãi" as UC_Stats
}

' Main connection
Admin --> UC_Main

' Extend to main categories
UC_Coupons .up.> UC_Main : <<extend>>
UC_Promotions .up.> UC_Main : <<extend>>
UC_FlashSale .down.> UC_Main : <<extend>>
UC_Stats .down.> UC_Main : <<extend>>

' Coupons sub-functions
UC_AddCoupon .up.> UC_Coupons : <<extend>>
UC_EditCoupon .up.> UC_Coupons : <<extend>>
UC_DeleteCoupon .up.> UC_Coupons : <<extend>>
UC_CopyCoupon .up.> UC_Coupons : <<extend>>

' Promotions sub-functions
UC_AddPromo .down.> UC_Promotions : <<extend>>
UC_EditPromo .down.> UC_Promotions : <<extend>>
UC_DeletePromo .down.> UC_Promotions : <<extend>>
UC_AddPromo ..> UC_SetTime : <<include>>
UC_AddPromo ..> UC_SelectProducts : <<include>>

' Flash Sale sub-functions
UC_AddFlash .down.> UC_FlashSale : <<extend>>
UC_EditFlash .down.> UC_FlashSale : <<extend>>
UC_DeleteFlash .down.> UC_FlashSale : <<extend>>
UC_AddFlash ..> UC_Countdown : <<include>>
UC_AddFlash ..> UC_SelectFlashProducts : <<include>>

@enduml
