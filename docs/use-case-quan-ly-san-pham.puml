@startuml Use Case - Quản lý Sản phẩm

skinparam backgroundColor #87CEEB
skinparam usecase {
    BackgroundColor #87CEEB
    BorderColor #000000
}

left to right direction

actor "Admin" as Admin

rectangle "Quản lý Sản phẩm" {
    usecase "Quản lý\nsản phẩm" as UC_Main
    
    usecase "Xem danh sách\nsản phẩm" as UC_ViewList
    usecase "Thêm sản phẩm" as UC_Add
    usecase "Sửa sản phẩm" as UC_Edit
    usecase "Xóa sản phẩm" as UC_Delete
    usecase "Tìm kiếm\nsản phẩm" as UC_Search
    usecase "Lọc sản phẩm\ntheo danh mục" as UC_FilterCategory
    usecase "Lọc sản phẩm\ntheo trạng thái" as UC_FilterStatus
    usecase "Quản lý\nhình ảnh" as UC_Images
    usecase "Quản lý\nbiến thể" as UC_Variants
    usecase "Cập nhật\ntrạng thái" as UC_Status
    usecase "Quản lý\ngiá bán" as UC_Price
}

' Main connection
Admin --> UC_Main

' Extend relationships
UC_ViewList .up.> UC_Main : <<extend>>
UC_Add .up.> UC_Main : <<extend>>
UC_Edit .up.> UC_Main : <<extend>>
UC_Delete .up.> UC_Main : <<extend>>
UC_Search .down.> UC_Main : <<extend>>
UC_FilterCategory .down.> UC_Main : <<extend>>
UC_FilterStatus .down.> UC_Main : <<extend>>

' Include relationships (sub-functions of Add/Edit)
UC_Add ..> UC_Images : <<include>>
UC_Add ..> UC_Variants : <<include>>
UC_Add ..> UC_Price : <<include>>

UC_Edit ..> UC_Images : <<include>>
UC_Edit ..> UC_Variants : <<include>>
UC_Edit ..> UC_Status : <<include>>
UC_Edit ..> UC_Price : <<include>>

@enduml
