@startuml Use Case - Khách hàng Quản lý Tài khoản

skinparam backgroundColor #87CEEB
skinparam usecase {
    BackgroundColor #87CEEB
    BorderColor #000000
}

left to right direction

actor "Khách hàng" as Customer

rectangle "Quản lý Tài khoản" {
    usecase "Quản lý\ntài khoản" as UC_Main
    
    ' === ĐĂNG NHẬP / ĐĂNG KÝ ===
    usecase "Đăng ký\ntài khoản" as UC_Register
    usecase "Đăng nhập" as UC_Login
    usecase "Đăng xuất" as UC_Logout
    usecase "Quên mật khẩu" as UC_ForgotPassword
    
    ' === THÔNG TIN CÁ NHÂN ===
    usecase "Xem thông tin\ncá nhân" as UC_ViewProfile
    usecase "Cập nhật\nthông tin" as UC_UpdateProfile
    usecase "Đổi mật khẩu" as UC_ChangePassword
    
    ' === ĐỊA CHỈ ===
    usecase "Quản lý\nđịa chỉ" as UC_Address
    usecase "Thêm địa chỉ\nmới" as UC_AddAddress
    usecase "Sửa địa chỉ" as UC_EditAddress
    usecase "Xóa địa chỉ" as UC_DeleteAddress
    usecase "Đặt địa chỉ\nmặc định" as UC_DefaultAddress
    
    ' === LỊCH SỬ ===
    usecase "Xem lịch sử\nđơn hàng" as UC_OrderHistory
    usecase "Xem chi tiết\nđơn hàng" as UC_OrderDetail
    
    ' === YÊU THÍCH ===
    usecase "Xem danh sách\nyêu thích" as UC_Wishlist
}

' Main connection
Customer --> UC_Main

' Extend relationships - Đăng nhập/Đăng ký
UC_Register .up.> UC_Main : <<extend>>
UC_Login .up.> UC_Main : <<extend>>
UC_Logout .up.> UC_Main : <<extend>>
UC_ForgotPassword .up.> UC_Main : <<extend>>

' Extend relationships - Thông tin cá nhân
UC_ViewProfile .down.> UC_Main : <<extend>>
UC_UpdateProfile .down.> UC_Main : <<extend>>
UC_ChangePassword .down.> UC_Main : <<extend>>

' Extend relationships - Địa chỉ
UC_Address .down.> UC_Main : <<extend>>
UC_AddAddress .down.> UC_Address : <<extend>>
UC_EditAddress .down.> UC_Address : <<extend>>
UC_DeleteAddress .down.> UC_Address : <<extend>>
UC_DefaultAddress .down.> UC_Address : <<extend>>

' Extend relationships - Lịch sử & Yêu thích
UC_OrderHistory .down.> UC_Main : <<extend>>
UC_Wishlist .down.> UC_Main : <<extend>>

' Include relationships
UC_ViewProfile ..> UC_Login : <<include>>
UC_UpdateProfile ..> UC_Login : <<include>>
UC_ChangePassword ..> UC_Login : <<include>>
UC_Address ..> UC_Login : <<include>>
UC_OrderHistory ..> UC_Login : <<include>>
UC_Wishlist ..> UC_Login : <<include>>
UC_OrderDetail ..> UC_OrderHistory : <<include>>

@enduml
